#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.

menuentry "" --hotkey " " --class hidden {
    if [ -f "${prefix}/grub_advanced.cfg" ]; then
        configfile "${prefix}/grub_advanced.cfg"
    elif [ -f "/grub/grub_advanced.cfg" ]; then
        configfile "/grub/grub_advanced.cfg"
    elif [ -f "/boot/grub/grub_advanced.cfg" ]; then
        configfile "/boot/grub/grub_advanced.cfg"
    fi
}
