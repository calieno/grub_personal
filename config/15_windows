#!/bin/sh
exec tail -n +3 $0

if [ "$grub_platform" = "efi" ]; then
    menuentry "Windows Boot Manager" --class windows --class os $menuentry_id_option "windows-boot-manager" {
        savedefault
        insmod part_gpt
        insmod fat
        search --no-floppy --fs-uuid --set=root {{WIN_EFI_UUID}}
        chainloader /efi/Microsoft/Boot/bootmgfw.efi
    }
fi
